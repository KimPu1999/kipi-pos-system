APP_NAME="Kipi POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
DB_CONNECTION=sqlite

# Order email notifications (SMTP credentials remain on the server)
ORDER_EMAIL_ENABLED=false
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=orders@example.com
MAIL_FROM_NAME="Kipi POS"
ORDER_ADMIN_EMAIL=
FRONTEND_URL=http://localhost:5173

# Automatic Google Sheets archive (credentials stay private on the backend)
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CREDENTIALS_PATH=
